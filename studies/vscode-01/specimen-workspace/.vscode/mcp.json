        "${workspaceFolder}/../bin/study-mcp-server.mjs",
        "--condition-env",
        "CLOSUREPROBE_STUDY_CONDITION"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.study-condition.local.env"
    }
  }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://risu-research.org/closureprobe/schemas/closure-trace.schema.json",
  "title": "Closure Trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["traceId", "request", "stages"],
  "properties": {
    "traceId": { "type": "string", "minLength": 1 },
    "request": true,
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stageId",
          "kind",
          "observation",
          "claim",
          "introducedValidatedEvidence"
        ],
        "properties": {
          "stageId": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "source",
              "adapter",
              "mcp_wire",
              "client",
              "model_projection",
              "agent_claim",
              "other"
            ]
          },
          "observation": {
            "$ref": "closure-observation.schema.json"
          },
          "claim": { "enum": ["none", "unknown", "some", "no_claim"] },
          "introducedValidatedEvidence": { "type": "boolean" },
          "rawDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    }
  }
}

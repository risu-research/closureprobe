{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://risu-research.org/closureprobe/schemas/closure-trace.schema.json",
  "title": "Closure Trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["traceId", "request", "sourceContext", "proposition", "rootEvidence", "stages"],
  "properties": {
    "traceId": { "type": "string", "minLength": 1 },
    "request": true,
    "sourceContext": { "$ref": "source-grounding.schema.json#/$defs/sourceContext" },
    "proposition": { "$ref": "#/$defs/proposition" },
    "rootEvidence": { "$ref": "#/$defs/evidenceIntroduction" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stageId", "kind", "observation", "claim"],
        "properties": {
          "stageId": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "source",
              "adapter",
              "mcp_wire",
              "client",
              "model_projection",
              "agent_claim",
              "other"
            ]
          },
          "observation": { "$ref": "closure-observation.schema.json" },
          "claim": { "$ref": "#/$defs/claim" },
          "evidenceIntroduction": { "$ref": "#/$defs/evidenceIntroduction" },
          "rawDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "predicate", "scope"],
      "properties": {
        "subject": { "type": "object", "minProperties": 1 },
        "predicate": { "type": "object", "minProperties": 1 },
        "scope": { "type": "object", "minProperties": 1 }
      }
    },
    "propositionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sourceContextDigest", "propositionDigest"],
      "properties": {
        "algorithm": { "const": "closureprobe-proposition-v2" },
        "sourceContextDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "propositionDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["none", "unknown", "some", "no_claim"] },
        "propositionBinding": { "$ref": "#/$defs/propositionBinding" },
        "artifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "evidenceIntroduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "profileVersion",
        "request",
        "response",
        "grounding",
        "requestDigest",
        "responseDigest"
      ],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "profileVersion": { "type": "string", "minLength": 1 },
        "request": true,
        "response": true,
        "grounding": { "$ref": "source-grounding.schema.json" },
        "requestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "responseDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}

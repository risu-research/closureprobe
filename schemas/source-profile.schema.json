{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://risu-research.org/closureprobe/schemas/source-profile.schema.json",
  "title": "ClosureProbe Source Profile Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "authority",
    "groundingProducer",
    "supportedOperation",
    "negativeProposition",
    "supportedEvidenceUnits",
    "conservativeDefaults",
    "references"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "authority": { "type": "string", "format": "uri" },
    "groundingProducer": { "type": "string", "minLength": 1 },
    "supportedOperation": { "type": "string", "minLength": 1 },
    "negativeProposition": { "type": "string", "minLength": 1 },
    "supportedEvidenceUnits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "controlled_fixture",
          "single_root_response",
          "validated_traversal_bundle"
        ]
      }
    },
    "conservativeDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missingCoverage", "missingContinuation", "unsupportedVariant"],
      "properties": {
        "missingCoverage": { "const": "unknown" },
        "missingContinuation": { "const": "unknown" },
        "unsupportedVariant": { "const": "fail_closed" }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

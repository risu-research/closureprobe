{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://risu-research.org/closureprobe/schemas/source-grounding.schema.json",
  "title": "ClosureProbe Source Grounding",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceContext", "propositionScope"],
  "properties": {
    "sourceContext": { "$ref": "#/$defs/sourceContext" },
    "propositionScope": {
      "type": "object",
      "minProperties": 1
    }
  },
  "$defs": {
    "sourceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "instance", "authority"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "instance": { "type": "object", "minProperties": 1 },
        "authority": { "type": "object", "minProperties": 1 }
      }
    }
  }
}
